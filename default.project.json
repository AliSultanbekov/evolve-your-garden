{
  "name": "Evolve Your Garden",
  "globIgnorePaths": [ "**/.package-lock.json" ],
  "tree": {
    "$className": "DataModel",

    "ServerScriptService": {
      "Game": {
        "$className": "Folder",
        "Modules": {
          "$path": "src/modules"
        },
        "node_modules": {
          "$path": "node_modules"
        }
      },
      "Scripts": {
        "$path": "src/scripts/Server"
      }
    },

    "MaterialService": {
      "$className": "MaterialService",
      "$path": "src/MaterialService"
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Scripts": {
          "$path": "src/scripts/Client"
        }
      }
    },

    "StarterGui": {
      "$className": "StarterGui",
      "$path": "src/StarterGui"
    },

    "Workspace": {
      "$className": "Workspace",
      "$path": "src/Workspace"
    },

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$path": "src/ReplicatedStorage"
    }
  }
}